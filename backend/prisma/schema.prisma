// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Existing models (retained; DB is source of truth) ---

/// Person applying for roles; links to education, work history, resumes, and applications.
model Candidate {
  id              Int              @id @default(autoincrement())
  firstName       String           @db.VarChar(100)
  lastName        String           @db.VarChar(100)
  email           String           @unique @db.VarChar(255)
  phone           String?          @db.VarChar(32)
  address         String?          @db.VarChar(255)
  educations      Education[]
  workExperiences WorkExperience[]
  resumes         Resume[]
  applications    Application[]

  @@index([lastName, firstName])
}

/// Academic history row attached to a candidate.
model Education {
  id          Int       @id @default(autoincrement())
  institution String    @db.VarChar(100)
  title       String    @db.VarChar(250)
  startDate   DateTime
  endDate     DateTime?
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([candidateId])
}

/// Prior employment row attached to a candidate.
model WorkExperience {
  id          Int       @id @default(autoincrement())
  company     String    @db.VarChar(100)
  position    String    @db.VarChar(100)
  description String?   @db.VarChar(200)
  startDate   DateTime
  endDate     DateTime?
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([candidateId])
}

/// Uploaded CV metadata (storage path + type) for a candidate.
model Resume {
  id          Int       @id @default(autoincrement())
  filePath    String    @db.VarChar(500)
  fileType    String    @db.VarChar(50)
  uploadDate  DateTime
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([candidateId])
}

// --- ERD: recruitment domain (docs/ERD.md) ---

/// Organization that owns employees and open positions.
model Company {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  positions Position[]

  @@index([name])
}

/// Staff member who belongs to a company and may conduct interviews.
model Employee {
  id         Int         @id @default(autoincrement())
  companyId  Int
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name       String      @db.VarChar(255)
  email      String      @db.VarChar(255)
  role       String      @db.VarChar(100)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  interviews Interview[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
}

/// Named interview category (e.g. phone screen, technical); reused across flow steps.
model InterviewType {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(100)
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  steps       InterviewStep[]

  @@unique([name])
}

/// Ordered sequence of interview steps; typically one flow per open position.
model InterviewFlow {
  id          Int             @id @default(autoincrement())
  description String          @db.VarChar(500)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  position    Position?
  steps       InterviewStep[]
}

/// Single stage inside a flow (type + name + order); maps to scheduled `Interview` rows.
model InterviewStep {
  id              Int           @id @default(autoincrement())
  interviewFlowId Int
  interviewFlow   InterviewFlow @relation(fields: [interviewFlowId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  interviewTypeId Int
  interviewType   InterviewType @relation(fields: [interviewTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name            String        @db.VarChar(200)
  orderIndex      Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  interviews      Interview[]

  @@unique([interviewFlowId, orderIndex])
  @@index([interviewFlowId])
  @@index([interviewTypeId])
}

/// Job opening: links a company to one interview flow and accepts applications.
model Position {
  id                  Int           @id @default(autoincrement())
  companyId           Int
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  interviewFlowId     Int           @unique
  interviewFlow       InterviewFlow @relation(fields: [interviewFlowId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  title               String        @db.VarChar(300)
  description         String?       @db.Text
  status              String        @db.VarChar(50)
  isVisible           Boolean       @default(true)
  location            String?       @db.VarChar(200)
  jobDescription      String?       @db.Text
  requirements        String?       @db.Text
  responsibilities    String?       @db.Text
  salaryMin           Decimal?      @db.Decimal(12, 2)
  salaryMax           Decimal?      @db.Decimal(12, 2)
  employmentType      String?       @db.VarChar(100)
  benefits            String?       @db.Text
  companyDescription  String?       @db.Text
  applicationDeadline DateTime?     @db.Date
  contactInfo         String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  applications        Application[]

  @@index([companyId])
  @@index([status, isVisible])
}

/// At most one job application per candidate per position (`@@unique` below). That
/// blocks a second row for the same pair; step-level retakes use `Interview.attempt`, not
/// multiple `Application` rows. See docs/prisma-migration-report.md and docs/audit-refactor.md.
model Application {
  id              Int         @id @default(autoincrement())
  positionId      Int
  position        Position    @relation(fields: [positionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  candidateId     Int
  candidate       Candidate   @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  applicationDate DateTime    @db.Date
  /// Allowed values are enforced in PostgreSQL (see migration: application_status_check).
  status          String      @db.VarChar(50)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  interviews      Interview[]

  @@unique([positionId, candidateId])
  @@index([positionId])
  @@index([candidateId])
  @@index([status])
  // Keyset pagination and status-filtered lists (see docs/audit.md)
  @@index([createdAt, id])
  @@index([status, id])
  @@index([status, candidateId])
}

/// Scheduled interview instance: one row per attempt at a step (`attempt` increments on retake).
model Interview {
  id              Int           @id @default(autoincrement())
  applicationId   Int
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  interviewStepId Int
  interviewStep   InterviewStep @relation(fields: [interviewStepId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// 1-based attempt per (application, step). Retakes = a new row with a higher `attempt`.
  /// `@@default(1)` does not choose the next value on retake: callers MUST set `attempt` to
  /// max(existing for this `applicationId` + `interviewStepId`) + 1 (see
  /// `getNextInterviewAttempt` in the backend) or inserts will hit P2002 on the unique.
  attempt         Int           @default(1)
  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  interviewDate   DateTime      @db.Date
  result          String?       @db.VarChar(100)
  score           Int?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([applicationId, interviewStepId, attempt])
  @@index([applicationId])
  @@index([interviewStepId])
  @@index([employeeId])
  @@index([interviewDate])
}
